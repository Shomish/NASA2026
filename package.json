{
  "name": "monitor-autonomo-salud-astronauta",
  "version": "1.0.0",
  "private": true,
  "description": "Monitor Autónomo de Salud para Astronautas - NASA Space Apps Challenge 2026",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n FRONT,BACK -c cyan,magenta \"npm:dev:front\" \"npm:dev:back\"",
    "dev:front": "vite",
    "dev:back": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "lint": "eslint src server",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"server/**/*.js\""
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  }
}
