# Variables de entorno de AYNI HEALTH
# Copia este archivo a .env y completa los valores. NO subas .env al repositorio.
# Este archivo contiene solo valores de ejemplo; nunca pongas secretos reales.

# ============================================================
# FRONTEND (Vite)
# ============================================================

# URL del backend API usada por el cliente. Vacío = usa el proxy de Vite.
VITE_API_URL=

# Muestra la caja de acceso de demostración en el frontend.
VITE_DEMO_MODE=true

# Host de Vite en desarrollo. false = solo localhost; true = red local.
HOST=false

# Destino del proxy /api de Vite en desarrollo.
VITE_API_PROXY_TARGET=http://localhost:3001

# ============================================================
# BACKEND (Express)
# ============================================================

# Puerto del servidor Express.
PUERTO=3001

# Entorno: development | test | production.
NODE_ENV=development

# Secreto para firmar los JWT (mínimo 16 caracteres; cámbialo en producción).
JWT_SECRET=cambia_esto_por_un_secreto_de_16_caracteres

# Siembra el usuario demo y datos de demostración. Debe ser false en producción.
DEMO_MODE=true

# Nivel de logs de pino: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info

# ============================================================
# BASE DE DATOS (MySQL / MariaDB)
# ============================================================

# Host de la base de datos.
DB_HOST=localhost

# Puerto de MySQL/MariaDB. Ajusta según tu instalación (el proyecto usa 3313 por defecto).
DB_PORT=3306

# Usuario de la base de datos.
DB_USER=root

# Contraseña de la base de datos (vacía en un XAMPP local típico).
DB_PASSWORD=

# Base principal y base de pruebas.
DB_NAME=ayni_health
DB_NAME_TEST=ayni_health_test

# ============================================================
# PROVEEDOR DE IA (solo backend; las claves nunca llegan al navegador)
# ============================================================

# Google AI Studio (Gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Proveedor compatible con OpenAI (OpenRouter, Groq, etc.).
# Si IA_URL_BASE tiene valor, el chatbot usa este proveedor.
IA_API_KEY=
IA_URL_BASE=
IA_MODEL=

# ============================================================
# NASA DONKI (clima espacial)
# ============================================================

# Clave gratuita de https://api.nasa.gov. DEMO_KEY sirve para pruebas locales.
NASA_API_KEY=DEMO_KEY
